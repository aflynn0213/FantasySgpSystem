# Use an official Python image as base
FROM python:3.12-slim

# Set the working directory inside the container
WORKDIR /FantasySgpSystem

ENV RUNNING_IN_DOCKER=true \
    PYTHONPATH=/FantasySgpSystem

ARG CHROME_VERSION=146.0.7680.165
ARG CHROME_DOWNLOAD_BASE=https://storage.googleapis.com/chrome-for-testing-public

# Install dependencies for Chrome & Selenium
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl unzip ca-certificates fonts-liberation \
    libappindicator3-1 libasound2 libgbm-dev libgtk-3-0 \
    libnss3 xdg-utils \
 && rm -rf /var/lib/apt/lists/*

# Install a matched Chrome for Testing browser and driver pair.
RUN set -eux \
 && wget -q -O /tmp/chrome-linux64.zip ${CHROME_DOWNLOAD_BASE}/${CHROME_VERSION}/linux64/chrome-linux64.zip \
 && wget -q -O /tmp/chromedriver-linux64.zip ${CHROME_DOWNLOAD_BASE}/${CHROME_VERSION}/linux64/chromedriver-linux64.zip \
 && unzip -q /tmp/chrome-linux64.zip -d /opt \
 && unzip -q /tmp/chromedriver-linux64.zip -d /opt \
 && ln -sf /opt/chrome-linux64/chrome /usr/bin/google-chrome \
 && ln -sf /opt/chrome-linux64/chrome /usr/local/bin/google-chrome \
 && mv /opt/chromedriver-linux64/chromedriver /usr/local/bin/chromedriver \
 && chmod +x /usr/bin/google-chrome /usr/local/bin/google-chrome /usr/local/bin/chromedriver \
 && rm -rf /tmp/chrome-linux64.zip /tmp/chromedriver-linux64.zip /opt/chromedriver-linux64

    
# Copy the requirements file into the container
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy import files
COPY . .
# Expose the port Flask runs on
EXPOSE 5000

RUN mkdir -p /downloads

COPY preseason_entrypoint.sh ./preseason_entrypoint.sh
RUN sed -i 's/\r$//' ./preseason_entrypoint.sh && chmod +x ./preseason_entrypoint.sh
ENTRYPOINT ["./preseason_entrypoint.sh"]

